<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="20 رسالة حب مخبأة داخل جرة جميلة، رسالة واحدة كل 24 ساعة."
    >

    <title>رسالة لكِ ❤️</title>


    <!-- =========================================
         GOOGLE FONTS
    ========================================== -->

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&family=Playfair+Display:ital,wght@400;500;600&display=swap"
        rel="stylesheet"
    >


    <!-- =========================================
         CSS
    ========================================== -->

    <style>

        /* =========================================
           RESET
        ========================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        html {
            scroll-behavior: smooth;
        }


        body {
            min-height: 100vh;

            overflow-x: hidden;

            font-family: "Cairo", sans-serif;

            color: #4b2935;

            background:
                radial-gradient(
                    circle at 10% 10%,
                    rgba(255, 181, 205, 0.45),
                    transparent 30%
                ),

                radial-gradient(
                    circle at 90% 90%,
                    rgba(213, 180, 255, 0.35),
                    transparent 30%
                ),

                linear-gradient(
                    135deg,
                    #fff5f8 0%,
                    #fffafd 45%,
                    #fff3f7 100%
                );
        }


        button {
            font-family: inherit;
        }


        /* =========================================
           BACKGROUND GLOW
        ========================================== */

        body::before {
            content: "";

            position: fixed;

            width: 500px;
            height: 500px;

            top: -250px;
            right: -200px;

            border-radius: 50%;

            background: rgba(255, 175, 202, 0.20);

            filter: blur(80px);

            pointer-events: none;

            z-index: 0;
        }


        body::after {
            content: "";

            position: fixed;

            width: 450px;
            height: 450px;

            bottom: -250px;
            left: -180px;

            border-radius: 50%;

            background: rgba(198, 160, 255, 0.16);

            filter: blur(80px);

            pointer-events: none;

            z-index: 0;
        }


        /* =========================================
           FLOATING HEARTS
        ========================================== */

        #hearts-container {
            position: fixed;

            inset: 0;

            overflow: hidden;

            pointer-events: none;

            z-index: 1;
        }


        .floating-heart {
            position: absolute;

            bottom: -80px;

            user-select: none;

            opacity: 0;

            color: rgba(206, 72, 113, 0.28);

            filter:
                drop-shadow(
                    0 5px 10px
                    rgba(150, 40, 80, 0.12)
                );

            animation:
                floatingHeart linear forwards;
        }


        @keyframes floatingHeart {

            0% {
                transform:
                    translateY(0)
                    translateX(0)
                    rotate(0deg)
                    scale(0.6);

                opacity: 0;
            }


            10% {
                opacity: 0.8;
            }


            50% {
                transform:
                    translateY(-50vh)
                    translateX(35px)
                    rotate(180deg)
                    scale(1);
            }


            100% {
                transform:
                    translateY(-120vh)
                    translateX(-40px)
                    rotate(360deg)
                    scale(0.8);

                opacity: 0;
            }
        }


        /* =========================================
           MAIN PAGE
        ========================================== */

        .page {
            position: relative;

            z-index: 2;

            min-height: 100vh;

            display: flex;

            flex-direction: column;

            align-items: center;

            padding:
                40px 20px 80px;
        }


        /* =========================================
           HEADER
        ========================================== */

        .header {
            text-align: center;

            margin-bottom: 15px;
        }


        .eyebrow {
            font-size: 13px;

            letter-spacing: 2px;

            color: #b15b76;

            margin-bottom: 8px;
        }


        .main-title {
            font-family: "Playfair Display", serif;

            font-size:
                clamp(38px, 7vw, 68px);

            line-height: 1.2;

            color: #8d304e;

            text-shadow:
                0 5px 20px
                rgba(150, 50, 80, 0.10);
        }


        .subtitle {
            margin-top: 12px;

            color: #8c6a75;

            font-size: 15px;

            line-height: 1.8;
        }


        /* =========================================
           DAY BADGE
        ========================================== */

        .day-badge {
            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 8px;

            margin-top: 18px;

            padding:
                9px 20px;

            border-radius: 100px;

            color: #9a4864;

            background:
                rgba(255,255,255,0.72);

            border:
                1px solid
                rgba(177, 83, 113, 0.14);

            box-shadow:
                0 10px 30px
                rgba(100, 35, 60, 0.08);

            backdrop-filter: blur(12px);

            font-size: 14px;
        }


        /* =========================================
           JAR AREA
        ========================================== */

        .jar-area {
            position: relative;

            width: 360px;

            height: 430px;

            display: flex;

            align-items: center;

            justify-content: center;
        }


        /* =========================================
           JAR WRAPPER
        ========================================== */

        .jar-wrapper {
            position: relative;

            width: 220px;

            height: 300px;

            cursor: pointer;

            transition:
                transform 0.35s ease,
                filter 0.35s ease;
        }


        .jar-wrapper:hover {
            transform:
                translateY(-8px)
                scale(1.015);

            filter:
                drop-shadow(
                    0 20px 20px
                    rgba(130, 40, 70, 0.10)
                );
        }


        .jar-wrapper.shake {
            animation:
                jarShake 0.85s ease;
        }


        @keyframes jarShake {

            0% {
                transform: rotate(0deg);
            }

            12% {
                transform: rotate(-8deg);
            }

            24% {
                transform: rotate(8deg);
            }

            36% {
                transform: rotate(-7deg);
            }

            48% {
                transform: rotate(7deg);
            }

            60% {
                transform: rotate(-5deg);
            }

            72% {
                transform: rotate(5deg);
            }

            84% {
                transform: rotate(-2deg);
            }

            100% {
                transform: rotate(0deg);
            }
        }


        /* =========================================
           JAR LID
        ========================================== */

        .jar-lid {
            position: absolute;

            z-index: 5;

            top: 4px;

            left: 20px;

            width: 180px;

            height: 43px;

            border-radius:
                11px
                11px
                7px
                7px;

            background:
                linear-gradient(
                    180deg,
                    #efb0c4 0%,
                    #c76f8b 100%
                );

            border:
                3px solid
                #aa5872;

            box-shadow:
                inset 0 4px 5px
                rgba(255,255,255,0.38),

                0 8px 15px
                rgba(90,30,50,0.16);
        }


        .jar-lid::before {
            content: "";

            position: absolute;

            top: 6px;

            left: 14px;

            right: 14px;

            height: 5px;

            border-radius: 50px;

            background:
                rgba(255,255,255,0.35);
        }


        .jar-lid::after {
            content: "";

            position: absolute;

            left: 10px;

            right: 10px;

            bottom: 5px;

            height: 4px;

            border-radius: 20px;

            background:
                rgba(90,30,50,0.12);
        }


        /* =========================================
           JAR BODY
        ========================================== */

        .jar-body {
            position: absolute;

            left: 0;

            bottom: 0;

            width: 220px;

            height: 275px;

            overflow: hidden;

            border-radius:
                32px
                32px
                48px
                48px;

            background:
                linear-gradient(
                    90deg,
                    rgba(255,255,255,0.88) 0%,
                    rgba(255,218,229,0.55) 35%,
                    rgba(255,255,255,0.78) 70%,
                    rgba(237,179,199,0.45) 100%
                );

            border:
                4px solid
                rgba(180,99,128,0.43);

            box-shadow:

                inset 15px 0 25px
                rgba(255,255,255,0.80),

                inset -15px 0 25px
                rgba(170,70,100,0.12),

                0 25px 50px
                rgba(95,30,55,0.17);
        }


        /* Glass highlight */

        .jar-body::before {
            content: "";

            position: absolute;

            left: 20px;

            top: 22px;

            width: 20px;

            height: 190px;

            border-radius: 50%;

            background:
                rgba(255,255,255,0.62);

            transform:
                rotate(7deg);

            filter: blur(2px);
        }


        /* Bottom reflection */

        .jar-body::after {
            content: "";

            position: absolute;

            left: 15px;

            right: 15px;

            bottom: 15px;

            height: 35px;

            border-radius: 50%;

            background:
                rgba(180,76,108,0.09);
        }


        /* =========================================
           JAR LABEL
        ========================================== */

        .jar-label {
            position: absolute;

            z-index: 4;

            top: 82px;

            left: 24px;

            right: 24px;

            padding:
                22px 10px;

            text-align: center;

            border-radius: 17px;

            background:
                rgba(255,247,250,0.76);

            border:
                1px solid
                rgba(180,80,110,0.18);

            box-shadow:
                0 8px 20px
                rgba(100,30,50,0.08);

            backdrop-filter: blur(5px);
        }


        .jar-label-icon {
            display: block;

            font-size: 35px;

            margin-bottom: 3px;
        }


        .jar-label-text {
            display: block;

            font-family:
                "Playfair Display",
                serif;

            font-size: 21px;

            color: #923b57;
        }


        .jar-label-small {
            display: block;

            margin-top: 5px;

            font-size: 10px;

            color: #b97c8d;

            letter-spacing: 1px;
        }


        /* =========================================
           JAR SHADOW
        ========================================== */

        .jar-shadow {
            position: absolute;

            bottom: 0;

            width: 190px;

            height: 28px;

            border-radius: 50%;

            background:
                rgba(80,30,50,0.13);

            filter: blur(10px);
        }


        /* =========================================
           PAPER
        ========================================== */

        .paper {
            position: absolute;

            z-index: 20;

            left: 50%;

            bottom: 70px;

            width: 155px;

            height: 112px;

            transform:
                translateX(-50%)
                translateY(120px)
                scale(0.2)
                rotate(8deg);

            opacity: 0;

            pointer-events: none;

            cursor: pointer;

            background:
                linear-gradient(
                    135deg,
                    #fffef9,
                    #fff8e8
                );

            border:
                1px solid
                #e9ddc7;

            border-radius: 4px;

            box-shadow:
                0 15px 35px
                rgba(80,50,25,0.18);

            transition:
                box-shadow 0.25s ease;
        }


        .paper:hover {
            box-shadow:
                0 20px 45px
                rgba(80,50,25,0.24);
        }


        .paper.show {
            animation:
                paperRise
                1.15s
                cubic-bezier(.2,.8,.2,1)
                forwards;

            pointer-events: auto;
        }


        @keyframes paperRise {

            0% {
                opacity: 0;

                transform:
                    translateX(-50%)
                    translateY(120px)
                    scale(0.2)
                    rotate(12deg);
            }


            45% {
                opacity: 1;

                transform:
                    translateX(-50%)
                    translateY(-70px)
                    scale(1.08)
                    rotate(-5deg);
            }


            70% {
                transform:
                    translateX(-50%)
                    translateY(-42px)
                    scale(0.97)
                    rotate(3deg);
            }


            100% {
                opacity: 1;

                transform:
                    translateX(-50%)
                    translateY(-52px)
                    scale(1)
                    rotate(0deg);
            }
        }


        /* Paper folds */

        .paper::before {
            content: "";

            position: absolute;

            left: 50%;

            top: 0;

            width: 1px;

            height: 100%;

            background:
                rgba(180,150,100,0.18);
        }


        .paper::after {
            content: "";

            position: absolute;

            top: 50%;

            left: 0;

            width: 100%;

            height: 1px;

            background:
                rgba(180,150,100,0.15);
        }


        .paper-content {
            position: absolute;

            inset: 0;

            display: flex;

            flex-direction: column;

            align-items: center;

            justify-content: center;

            color: #a36a5e;

            text-align: center;

            pointer-events: none;
        }


        .paper-icon {
            font-size: 32px;

            margin-bottom: 4px;
        }


        .paper-text {
            font-size: 12px;
        }


        /* =========================================
           NEXT INFORMATION
        ========================================== */

        .next-info {
            min-height: 65px;

            margin-top: -10px;

            text-align: center;

            color: #8c6b76;

            font-size: 13px;

            line-height: 1.9;
        }


        .timer {
            display: inline-block;

            margin-top: 3px;

            padding:
                4px 12px;

            border-radius: 50px;

            color: #a13f5f;

            background:
                rgba(255,255,255,0.65);

            font-weight: 700;

            direction: ltr;

            letter-spacing: 1px;
        }


        /* =========================================
           MESSAGE MODAL
        ========================================== */

        .message-overlay {
            position: fixed;

            inset: 0;

            z-index: 100;

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 20px;

            background:
                rgba(55,20,35,0.58);

            backdrop-filter:
                blur(9px);

            opacity: 0;

            visibility: hidden;

            transition:
                opacity 0.35s ease,
                visibility 0.35s ease;
        }


        .message-overlay.active {
            opacity: 1;

            visibility: visible;
        }


        /* =========================================
           MESSAGE CARD
        ========================================== */

        .message-card {
            position: relative;

            width:
                min(650px, 100%);

            max-height: 86vh;

            overflow-y: auto;

            padding:
                50px
                40px
                40px;

            background:
                linear-gradient(
                    135deg,
                    #fffdf8,
                    #fff8ef
                );

            border:
                1px solid
                #eadcc9;

            border-radius: 22px;

            box-shadow:
                0 35px 90px
                rgba(50,20,35,0.30);

            transform:
                translateY(35px)
                scale(0.92);

            transition:
                transform
                0.45s
                cubic-bezier(.2,.8,.2,1);
        }


        .message-overlay.active
        .message-card {

            transform:
                translateY(0)
                scale(1);
        }


        /* =========================================
           PAPER DECORATION
        ========================================== */

        .message-card::before {
            content: "♡";

            position: absolute;

            top: 13px;

            right: 20px;

            color:
                rgba(174,79,106,0.20);

            font-size: 32px;
        }


        .message-card::after {
            content: "♡";

            position: absolute;

            bottom: 12px;

            left: 20px;

            color:
                rgba(174,79,106,0.16);

            font-size: 28px;
        }


        /* =========================================
           CLOSE BUTTON
        ========================================== */

        .close-message {
            position: absolute;

            top: 15px;

            left: 15px;

            width: 40px;

            height: 40px;

            display: flex;

            align-items: center;

            justify-content: center;

            border: none;

            border-radius: 50%;

            background:
                #f5e1e8;

            color:
                #994a64;

            font-size: 23px;

            line-height: 1;

            cursor: pointer;

            transition:
                transform 0.25s ease,
                background 0.25s ease;
        }


        .close-message:hover {
            transform:
                rotate(90deg);

            background:
                #efd0dc;
        }


        /* =========================================
           MESSAGE CONTENT
        ========================================== */

        .message-day {
            text-align: center;

            font-size: 12px;

            color: #b2677e;

            min-height: 20px;
        }


        .message-title {
            margin-top: 12px;

            margin-bottom: 25px;

            text-align: center;

            font-family:
                "Playfair Display",
                serif;

            font-size:
                clamp(27px, 5vw, 37px);

            color:
                #8d3451;
        }


        .message-text {
            text-align: center;

            white-space: pre-line;

            font-size: 18px;

            line-height: 2.3;

            color: #5d414a;
        }


        .message-author {
            display: block;

            margin-top: 25px;

            text-align: center;

            font-family:
                "Playfair Display",
                serif;

            font-size: 18px;

            color: #9d4c66;
        }


        .message-heart {
            display: block;

            margin-top: 28px;

            text-align: center;

            font-size: 30px;

            animation:
                tinyHeart 1.8s ease-in-out infinite;
        }


        @keyframes tinyHeart {

            0%,
            100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.15);
            }
        }


        /* =========================================
           FINAL SECTION
        ========================================== */

        .final-section {
            display: none;

            width:
                min(1080px, 100%);

            margin-top: 30px;

            animation:
                finalAppear
                1s
                ease
                forwards;
        }


        .final-section.show {
            display: block;
        }


        @keyframes finalAppear {

            from {
                opacity: 0;

                transform:
                    translateY(35px);
            }

            to {
                opacity: 1;

                transform:
                    translateY(0);
            }
        }


        /* =========================================
           FINAL CARD
        ========================================== */

        .final-card {
            position: relative;

            overflow: hidden;

            padding:
                55px 45px;

            text-align: center;

            border-radius: 28px;

            background:
                rgba(255,255,255,0.74);

            border:
                1px solid
                rgba(185,92,125,0.16);

            box-shadow:
                0 25px 70px
                rgba(100,40,60,0.11);

            backdrop-filter:
                blur(14px);
        }


        .final-card::before {
            content: "♥";

            position: absolute;

            top: -30px;

            right: -20px;

            font-size: 180px;

            color:
                rgba(210,75,116,0.035);

            transform:
                rotate(15deg);
        }


        .final-card::after {
            content: "♥";

            position: absolute;

            bottom: -45px;

            left: -20px;

            font-size: 200px;

            color:
                rgba(210,75,116,0.03);

            transform:
                rotate(-15deg);
        }


        .final-heart {
            position: relative;

            z-index: 2;

            font-size: 60px;

            animation:
                finalHeartBeat
                1.5s
                ease-in-out
                infinite;
        }


        @keyframes finalHeartBeat {

            0%,
            100% {
                transform: scale(1);
            }

            20% {
                transform: scale(1.16);
            }

            35% {
                transform: scale(1);
            }
        }


        .final-title {
            position: relative;

            z-index: 2;

            margin-top: 12px;

            margin-bottom: 30px;

            font-family:
                "Playfair Display",
                serif;

            font-size:
                clamp(32px, 6vw, 52px);

            color:
                #8d304e;
        }


        .final-text {
            position: relative;

            z-index: 2;

            max-width: 800px;

            margin: auto;

            font-size: 18px;

            line-height: 2.4;

            color: #5e424b;
        }


        /* =========================================
           GALLERY
        ========================================== */

        .gallery-heading {
            position: relative;

            z-index: 2;

            margin-top: 50px;

            margin-bottom: 20px;

            font-family:
                "Playfair Display",
                serif;

            font-size: 30px;

            color:
                #8d3451;
        }


        .gallery {
            position: relative;

            z-index: 2;

            width: 100%;

            overflow: hidden;

            border-radius: 22px;
        }


        .gallery-track {
            display: flex;

            width: max-content;

            animation:
                galleryMove
                35s
                linear
                infinite;
        }


        .gallery:hover
        .gallery-track {
            animation-play-state: paused;
        }


        .gallery-image {
            flex-shrink: 0;

            width: 230px;

            height: 290px;

            margin: 7px;

            object-fit: cover;

            border-radius: 18px;

            box-shadow:
                0 10px 25px
                rgba(60,30,40,0.14);

            transition:
                transform 0.3s ease;
        }


        .gallery-image:hover {
            transform:
                scale(1.04);
        }


        @keyframes galleryMove {

            from {
                transform:
                    translateX(0);
            }

            to {
                transform:
                    translateX(-50%);
            }
        }


        /* =========================================
           RESET BUTTON
        ========================================== */

        .reset-button {
            position: relative;

            z-index: 3;

            margin-top: 35px;

            padding:
                11px 22px;

            border:
                1px solid
                rgba(150,70,95,0.20);

            border-radius: 100px;

            background:
                rgba(255,255,255,0.75);

            color:
                #98506a;

            cursor: pointer;

            transition:
                transform 0.25s ease,
                background 0.25s ease;
        }


        .reset-button:hover {
            transform:
                translateY(-2px);

            background:
                #fff;
        }


        /* =========================================
           HIDDEN CLASS
        ========================================== */

        .hidden {
            display: none !important;
        }


        /* =========================================
           RESPONSIVE
        ========================================== */

        @media (max-width: 600px) {

            .page {
                padding:
                    25px 14px 60px;
            }


            .header {
                margin-bottom: 0;
            }


            .eyebrow {
                font-size: 11px;

                letter-spacing: 1.5px;
            }


            .subtitle {
                font-size: 13px;
            }


            .jar-area {
                width: 320px;

                height: 390px;
            }


            .jar-wrapper {
                transform:
                    scale(0.92);
            }


            .jar-wrapper:hover {
                transform:
                    scale(0.92);
            }


            .message-card {
                padding:
                    45px 20px 30px;

                border-radius: 18px;
            }


            .message-text {
                font-size: 16px;

                line-height: 2.15;
            }


            .message-title {
                font-size: 28px;
            }


            .final-card {
                padding:
                    40px 18px;
            }


            .final-text {
                font-size: 16px;

                line-height: 2.2;
            }


            .gallery-image {
                width: 175px;

                height: 225px;
            }


            .gallery-heading {
                font-size: 27px;
            }
        }


        @media (max-width: 380px) {

            .jar-area {
                width: 300px;
            }


            .jar-wrapper {
                transform:
                    scale(0.85);
            }


            .jar-wrapper:hover {
                transform:
                    scale(0.85);
            }
        }

    </style>

</head>


