        /* =========================================
           SETTINGS
        ========================================== */

        const TOTAL_DAYS = 20;

        const TWENTY_FOUR_HOURS =
            24 * 60 * 60 * 1000;

        const STORAGE_KEY =
            "romantic_jar_20_days_v2";


        /* =========================================
