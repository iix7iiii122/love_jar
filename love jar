        /* =========================================
           STORAGE AVAILABLE
           
           localStorage يستمر بين مرات فتح الصفحة
           على نفس origin، لذلك هو مناسب لحفظ
           تقدم المستخدم في هذه النسخة.
        ========================================== */

        function storageAvailable() {

            try {

                const testKey =
                    "__romantic_storage_test__";

                localStorage.setItem(
                    testKey,
                    "test"
                );

                localStorage.removeItem(
                    testKey
                );

                return true;

            } catch (error) {

                return false;
            }
        }


        const hasStorage =
            storageAvailable();


        /* =========================================
           LOAD STATE
        ========================================== */

        function loadState() {

            if (!hasStorage) {
                return;
            }


            try {

                const saved =
                    localStorage.getItem(
                        STORAGE_KEY
                    );


                if (!saved) {
                    return;
                }


                const parsed =
                    JSON.parse(saved);


                if (
                    parsed &&
                    Array.isArray(parsed.openedDays)
                ) {

                    state =
                        parsed;
                }


            } catch (error) {

                console.warn(
                    "تعذر قراءة تقدم المستخدم.",
                    error
                );

                state = {
                    openedDays: [],
                    lastOpenedAt: null
                };
            }
        }


        /* =========================================
           SAVE STATE
        ========================================== */

        function saveState() {

            if (!hasStorage) {
                return;
            }


            try {

                localStorage.setItem(
                    STORAGE_KEY,
                    JSON.stringify(state)
                );

            } catch (error) {

                console.warn(
                    "تعذر حفظ تقدم المستخدم.",
                    error
                );
            }
        }


        /* =========================================
           CURRENT DAY
        ========================================== */

        function getCurrentDayIndex() {

            return state.openedDays.length;
        }


        /* =========================================
           CAN OPEN NEW MESSAGE?
        ========================================== */

        function canOpenNewMessage() {

            /*
             * إذا فتح جميع الرسائل
             */

            if (
                getCurrentDayIndex()
                >= TOTAL_DAYS
            ) {

                return false;
            }


            /*
             * أول رسالة
             */

            if (
                !state.lastOpenedAt
            ) {

                return true;
            }


            /*
             * حساب الوقت منذ آخر فتح
             */

            const elapsed =
                Date.now()
                -
                Number(state.lastOpenedAt);


            return (
                elapsed
                >=
                TWENTY_FOUR_HOURS
            );
        }


        /* =========================================
           TIME REMAINING
        ========================================== */

        function getRemainingTime() {

            if (
                !state.lastOpenedAt
            ) {

                return 0;
            }


            const elapsed =
                Date.now()
                -
                Number(state.lastOpenedAt);


            const remaining =
                TWENTY_FOUR_HOURS
                -
                elapsed;


            return Math.max(
                0,
                remaining
            );
        }


